# ======================================================================
# Ямастер Чек — автозапуск AdGuard VPN CLI в режиме TUN (v1.70.24)
# Требования: adguardvpn-cli установлен (/usr/local/bin), вход выполнен
# (`sudo adguardvpn-cli login`), режим задан (`adguardvpn-cli config
# set-mode TUN` + `site-exclusions mode selective` с доменами Telegram).
# Установка:
#   sudo cp adguard-vpn-telegram.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now adguard-vpn-telegram
# Проверка (в TUN трафик идёт прозрачно, прокси не нужен):
#   curl https://api.telegram.org/ -m 10
# Логи: journalctl -u adguard-vpn-telegram -f
# Локацию можно закрепить флагом: ExecStart=... connect -l "Нидерланды" --no-fork
# ======================================================================
[Unit]
Description=AdGuard VPN CLI (TUN, only Telegram routed, for Ymaster Check bot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=HOME=/root
ExecStart=/usr/local/bin/adguardvpn-cli connect --no-fork
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
