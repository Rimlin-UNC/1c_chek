# ======================================================================
# DocVer — jail для fail2ban (ООО «Ямастер», ymaster.ru)
# 12 «плохих» ответов за 2 минуты → бан IP на 15 минут.
# ======================================================================
[docver]
enabled  = true
port     = http,https
filter   = docver
logpath  = /var/log/nginx/docver.access.log
maxretry = 12
findtime = 120
bantime  = 900
action   = iptables-multiport[name=docver, port="http,https", protocol=tcp]
