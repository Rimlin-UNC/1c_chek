# ОБРАЗЕЦ: не включается автоматически; перед применением проверьте пути,
# пользователя и настройку YM_MONITOR_HISTORY_FILE согласно docs/Monitor.md.
[Unit]
Description=DocVer — разовый сбор истории локальных показателей

[Service]
Type=oneshot
User=ymaster
Group=ymaster
WorkingDirectory=/opt/docver
ExecStart=/opt/docver/venv/bin/python -m app.services.server_history collect
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/docver/data
PrivateTmp=true
