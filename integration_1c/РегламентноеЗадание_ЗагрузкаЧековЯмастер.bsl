// ======================================================================
// Ямастер Чек — регламентное задание загрузки чеков в 1С (Push-режим)
// Разработчик и владелец идеи: ООО «Ямастер»
// Сайт: https://ymaster.ru | E-mail: info@ymaster.ru
//
// СКОПИРУЙТЕ этот модуль в общий модуль 1С, например «ЗагрузкаЧековЯмастер».
// Настройте регламентное задание с вызовом ЗагрузкаЧековЯмастер.ВыполнитьЗагрузку()
// раз в 5–15 минут. Дедупликация на стороне 1С: по РегистрСведений
// «ЯмастерЗагруженныеЧеки» (измерения ФН, ФД, ФП) — создаваемые при первом
// запуске автоматически.
//
// ТРЕБОВАНИЯ: платформа 8.3.10+, конфигурации БП 3.0 / ERP 2 / УТ 11
// ======================================================================

// ----------------------- НАСТРОЙКИ (заполните) -----------------------
Функция АдресСервера()
	// Адрес сервера «Ямастер Чек» (без завершающего слэша)
	Возврат "https://check.example.ru"; // ЗАМЕНИТЕ
КонецФункции

Функция ТокенAPI()
	// Значение из веб-клиента: Настройки → Интеграция с 1С → «показать»
	Возврат "ВСТАВЬТЕ_ТОКЕН";           // ЗАМЕНИТЕ
КонецФункции

Функция ДокументЦели()
	Возврат "ПоступлениеТоваровУслуг";  // или "АвансовыйОтчет"
КонецФункции

// ------------------------ ГЛАВНАЯ ПРОЦЕДУРА ---------------------------
Процедура ВыполнитьЗагрузку() Экспорт
	Чеки = ПолучитьНовыеЧеки();
	Если Чеки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Загружено := 0;
	Пропущено := 0;
	Подтверждённые := Новый Массив;

	Для Каждого Чек Из Чеки Цикл
		Если ЧекУжеЗагружен(Чек.ФН, Чек.ФД, Чек.ФП) Тогда
			Пропущено := Пропущено + 1;
			Подтверждённые.Добавить(Чек.ID);
			Продолжить;
		КонецЕсли;

		СсылкаДокумента = СоздатьДокументПоступления(Чек);
		Если СсылкаДокумента <> Неопределено Тогда
			ОтметитьЗагруженным(Чек.ФН, Чек.ФД, Чек.ФП, СсылкаДокумента);
			Подтверждённые.Добавить(Чек.ID);
			Загружено := Загружено + 1;
		КонецЕсли;
	КонецЦикла;

	// Подтверждаем серверу: эти чеки больше не присылать
	Если Подтверждённые.Количество() > 0 Тогда
		ПодтвердитьЗагрузку(Подтверждённые);
	КонецЕсли;

	ЗаписьЖурналаРегистрации("Ямастер.ЗагрузкаЧеков",
		УровеньЖурналаРегистрации.Информация,,,
		СтрШаблон("Загружено: %1, пропущено (дубликаты): %2", Загружено, Пропущено));
КонецПроцедуры

// --------------------- ПОЛУЧЕНИЕ ЧЕКОВ С СЕРВЕРА ----------------------
Функция ПолучитьНовыеЧеки()
	URL := АдресСервера() + "/onec/v1/receipts/pull?limit=100&only_verified=true";
	Заголовки := Новый Соответствие;
	Заголовки.Вставить("X-API-Token", ТокенAPI());

	HTTPСоединение := Новый HTTPСоединение(ХостАдресСервера(), 443,,,,
		5, Новый ЗащищенноеСоединениеOpenSSL);
	Запрос := Новый HTTPЗапрос(ПутьЗапроса(), Заголовки);
	Ответ := HTTPСоединение.Получить(Запрос);

	Если Ответ.КодСостояния <> 200 Тогда
		ЗаписьЖурналаРегистрации("Ямастер.ЗагрузкаЧеков",
			УровеньЖурналаРегистрации.Ошибка,,,
			"Сервер вернул код " + Ответ.КодСостояния);
		Возврат Новый Массив;
	КонецЕсли;

	Чтение := Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Данные := ПрочитатьJSON(Чтение, Ложь);
	Чтение.Закрыть();

	Возврат Данные.Получить("receipts", Новый Массив);
КонецФункции

// Вспомогательные: разбор адреса
Функция ХостАдресСервера()
	Адрес := АдресСервера();
	Адрес = СтрЗаменить(Адрес, "https://", "");
	Адрес = СтрЗаменить(Адрес, "http://", "");
	Возврат СтрРазделить(Адрес, "/")[0];
КонецФункции

Функция ПутьЗапроса()
	Части := СтрРазделить(СтрЗаменить(СтрЗаменить(АдресСервера(), "https://", ""),
		"http://", ""), "/");
	Путь := "";
	Для Индекс := 1 По Части.ВГраница() Цикл
		Путь := Путь + "/" + Части[Индекс];
	КонецЦикла;
	Возврат Путь + "/onec/v1/receipts/pull?limit=100&only_verified=true";
КонецФункции

// ------------------- ДЕДУПЛИКАЦИЯ (регистр сведений) ------------------
Процедура ПриПервомЗапускеСоздатьСтруктуру()
	// Регистр сведений «ЯмастерЗагруженныеЧеки» создайте в конфигураторе:
	//   Измерения: ФН (Строка 20), ФД (Строка 10), ФП (Строка 10)
	//   Ресурсы:   ДокументСсылка (ДокументСсылка.<любой>), ДатаЗагрузки (Дата)
	// Либо используйте код ниже для программного контроля существования.
КонецПроцедуры

Функция ЧекУжеЗагружен(ФН, ФД, ФП)
	Запрос := Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ РегистрСведений.ЯмастерЗагруженныеЧеки
	|ГДЕ ФН = &ФН И ФД = &ФД И ФП = &ФП");
	Запрос.УстановитьПараметр("ФН", ФН);
	Запрос.УстановитьПараметр("ФД", ФД);
	Запрос.УстановитьПараметр("ФП", ФП);
	Возврат НЕ Запрос.Выполнить().Пустой();
КонецФункции

Процедура ОтметитьЗагруженным(ФН, ФД, ФП, СсылкаДокумента)
	Набор := РегистрыСведений.ЯмастерЗагруженныеЧеки.СоздатьНаборЗаписей();
	Запись := Набор.Добавить();
	Запись.ФН = ФН; Запись.ФД = ФД; Запись.ФП = ФП;
	Запись.ДокументСсылка = СсылкаДокумента;
	Запись.ДатаЗагрузки = ТекущаяДатаСеанса();
	Набор.Записать(Истина);
КонецПроцедуры

// --------------------- СОЗДАНИЕ ДОКУМЕНТА В 1С ------------------------
Функция СоздатьДокументПоступления(Чек)
	// Пример для БП 3.0 / УТ 11: «Поступление товаров и услуг».
	// Для ERP 2 названия реквизитов могут отличаться — см. docs/INTEGRATION_1C.md.
	Попытка
		Док := Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
		Док.Дата = ТекущаяДатаСеанса();
		Док.Комментарий = "Ямастер Чек: ФН " + Чек.ФН + " ФД " + Чек.ФД
			+ " ФП " + Чек.ФП + " от " + Формат(Чек.Дата, "ДЛФ=DT");

		// Сумма документа
		Док.СуммаДокумента = Чек.Сумма;

		// Табличная часть «Товары» (если позиции есть на сервере)
		Если Чек.Свойство("items") И Чек.items.Количество() > 0 Тогда
			Для Каждого Позиция Из Чек.items Цикл
				Строка := Док.Товары.Добавить();
				Строка.Номенклатура = НайтиИлиСоздатьНоменклатуру(Позиция.name);
				Строка.Количество = Позиция.qty;
				Строка.Цена = Позиция.price;
				Строка.Сумма = Позиция.sum;
			КонецЦикла;
		КонецЕсли;

		Док.Записать(РежимЗаписиДокумента.Проведение);
		Возврат Док.Ссылка;
	Исключение
		ЗаписьЖурналаРегистрации("Ямастер.ЗагрузкаЧеков",
			УровеньЖурналаРегистрации.Ошибка,,,
			"Не удалось создать документ: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция НайтиИлиСоздатьНоменклатуру(Наименование)
	Запрос := Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Номенклатура ГДЕ Наименование = &Имя");
	Запрос.УстановитьПараметр("Имя", Наименование);
	Выборка := Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	НовыйЭлемент := Справочники.Номенклатура.СоздатьЭлемент();
	НовыйЭлемент.Наименование = Наименование;
	НовыйЭлемент.НаименованиеПолное = Наименование;
	НовыйЭлемент.Записать();
	Возврат НовыйЭлемент.Ссылка;
КонецФункции

// ------------------------- ПОДТВЕРЖДЕНИЕ ACK ---------------------------
Процедура ПодтвердитьЗагрузку(СписокID)
	URL := АдресСервера() + "/onec/v1/receipts/ack";
	Заголовки := Новый Соответствие;
	Заголовки.Вставить("X-API-Token", ТокенAPI());
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Параметры := Новый Структура("ids", СписокID);
	ЗаписьJSON := Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Параметры);
	Тело := ЗаписьJSON.Закрыть();

	HTTPСоединение := Новый HTTPСоединение(ХостАдресСервера(), 443,,,,
		5, Новый ЗащищенноеСоединениеOpenSSL);
	Запрос := Новый HTTPЗапрос("/onec/v1/receipts/ack", Заголовки);
	Запрос.УстановитьТелоИзСтроки(Тело);
	Ответ := HTTPСоединение.ОтправитьДляОбработки(Запрос);
	// (ОтправитьДляОбработки = POST; в старых платформах — ВызватьHTTPМетод("POST", Запрос))
КонецПроцедуры
