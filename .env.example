# ======================================================================
# Ямастер Чек — пример файла конфигурации
# Разработчик и владелец идеи: ООО «Ямастер» | ymaster.ru | chek@ymaster.ru
#
# Скопируйте файл в .env и заполните свои значения:
#   cp .env.example .env
# ======================================================================

# --- Безопасность -----------------------------------------------------
# ОБЯЗАТЕЛЬНО смените в production! Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=ymaster-dev-secret-change-me-in-production

# --- База данных --------------------------------------------------------
# По умолчанию — SQLite (data/ymaster_check.db). Для PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://ymaster:ПАРОЛЬ@localhost:5432/ymaster_check
# DATABASE_URL=

# --- Supabase (отдельный демо-контур, не рабочая БД) ---------------------
# Включает страницу «Supabase демо» для администратора и бухгалтера.
# Данные читаются из Supabase REST; рабочая DATABASE_URL не меняется.
SUPABASE_DEMO_ENABLED=0
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Только publishable key (sb_publishable_...). НЕ secret/service_role.
SUPABASE_PUBLISHABLE_KEY=
# Для доверенного iframe предпросмотра можно задать FRAME_ANCESTORS=https://*.e2b.app
# По умолчанию для production: 'none'.

# --- Проверка чеков в ФНС -----------------------------------------------
# Провайдер: mock — демо-проверка (по умолчанию), fns — реальное API ФНС
FNS_PROVIDER=mock
# Адрес «Открытого API проверки чека ККТ»
FNS_API_BASE=https://openapi.nalog.ru:8090
# Мастер-токен (выдаётся ФНС по заявке — см. docs/knowledge/fns_auth.md)
FNS_MASTER_TOKEN=
# Кэш результатов проверки, дней
FNS_CACHE_TTL_DAYS=30

# --- Интеграция с 1С ------------------------------------------------------
# Токен, который указывается в заголовке X-API-Token при обращении 1С к серверу.
# Оставьте пустым — будет сгенерирован автоматически при первом старте.
ONEC_API_TOKEN=

# --- Банк по API: Точка (v1.70.99) -------------------------------------------
# Приложение OAuth 2.0 владельца сервера: интернет-банк Точки → «Интеграции и API» →
# «Подключить OAuth». Адрес возврата для приложения: <адрес сайта>/api/v1/bank/tochka/callback.
# Заданы — компании подключают банк одной кнопкой; пусто — каждая компания вводит
# client_id и client_secret своего приложения (или JWT-ключ) в карточке.
TOCHKA_CLIENT_ID=
TOCHKA_CLIENT_SECRET=

# --- Прочее -----------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=720
MAX_UPLOAD_MB=12
