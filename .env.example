# ======================================================================
# DocVer — пример файла конфигурации
# Разработчик и владелец идеи: ООО «Ямастер» | ymaster.ru | i@docver.ru
#
# Скопируйте файл в .env и заполните свои значения:
#   cp .env.example .env
#
# Совместимость: переменные YM_* по-прежнему принимаются как алиасы DOCVER_*.
# ======================================================================

# --- Безопасность -----------------------------------------------------
# ОБЯЗАТЕЛЬНО смените в production! Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=docver-dev-secret-change-me-in-production

# --- База данных --------------------------------------------------------
# По умолчанию — SQLite (data/docver.db). Для PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://ymaster:ПАРОЛЬ@localhost:5432/docver
# DATABASE_URL=

# --- Supabase (отдельный демо-контур, не рабочая БД) ---------------------
# Включает страницу «Supabase демо» для администратора и бухгалтера.
# Данные читаются из Supabase REST; рабочая DATABASE_URL не меняется.
SUPABASE_DEMO_ENABLED=0
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Только publishable key (sb_publishable_...). НЕ secret/service_role.
SUPABASE_PUBLISHABLE_KEY=
# Для доверенного iframe предпросмотра можно задать FRAME_ANCESTORS=https://*.e2b.app
# По умолчанию для production: 'none'.

# --- Проверка чеков в ФНС -----------------------------------------------
# Провайдер: mock — демо-проверка (по умолчанию), fns — реальное API ФНС
FNS_PROVIDER=mock
# Адрес «Открытого API проверки чека ККТ»
FNS_API_BASE=https://openapi.nalog.ru:8090
# Мастер-токен (выдаётся ФНС по заявке — см. docs/knowledge/fns_auth.md)
FNS_MASTER_TOKEN=
# Кэш результатов проверки, дней
FNS_CACHE_TTL_DAYS=30

# --- Интеграция с 1С ------------------------------------------------------
# Токен, который указывается в заголовке X-API-Token при обращении 1С к серверу.
# Оставьте пустым — будет сгенерирован автоматически при первом старте.
ONEC_API_TOKEN=

# --- Банк по API: Точка (v1.70.99) -------------------------------------------
# Приложение OAuth 2.0 владельца сервера: интернет-банк Точки → «Интеграции и API» →
# «Подключить OAuth». Адрес возврата для приложения: <адрес сайта>/api/v1/bank/tochka/callback.
# Заданы — компании подключают банк одной кнопкой; пусто — каждая компания вводит
# client_id и client_secret своего приложения (или JWT-ключ) в карточке.
TOCHKA_CLIENT_ID=
TOCHKA_CLIENT_SECRET=

# --- Прочее -----------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=720
MAX_UPLOAD_MB=12

# v1.70.104 (T-63): первичка из почты. 1 — разрешить почтовый сервер во внутренней сети (свой
# Exchange или Dovecot в локальной сети компании); по умолчанию такие адреса запрещены (защита от SSRF)
# DOCVER_MAIL_PRIVATE_HOSTS=0  (алиас: YM_MAIL_PRIVATE_HOSTS)

# --- Приёмная папка первички (v1.73.0, T-109, ADR-60) ----------------------
# Каталог на сервере, куда складывают выгрузку УПД из СБИС: программа сама забирает оттуда XML и ZIP.
# Разрешённые корни через «;»: путь вне их не принимается (защита от чтения чужих каталогов сервера).
# Пусто — доступен только data/inbox внутри каталога программы.
# DOCVER_PRIMARY_INBOX_ROOTS=/srv/sbis-export;/mnt/share/upd  (алиас: YM_PRIMARY_INBOX_ROOTS)
# Путь по умолчанию, если администратор ещё не сохранил настройку в программе.
# DOCVER_PRIMARY_INBOX_PATH=/srv/sbis-export  (алиас: YM_PRIMARY_INBOX_PATH)
# 1 — полностью выключить фоновый обход (стенды, тесты, приёмка).
# DOCVER_PRIMARY_INBOX_OFF=0  (алиас: YM_PRIMARY_INBOX_OFF)
# Пароль и ключи СБИС здесь НЕ задаются: программа не входит в СБИС, документы выгружает человек из кабинета.
